[Unit]
Description=BBC Radio 2 HLS-to-Icecast relay
After=network-online.target icecast2.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ffmpeg -user_agent "VLC/3.0.18 LibVLC/3.0.18" -reconnect 1 -reconnect_streamed 1 -reconnect_delay_max 5 -i "https://lsn.lv/bbcradio.m3u8?station=bbc_radio_two&bitrate=96000" -avoid_negative_ts make_zero -fflags +genpts -vn -acodec libmp3lame -ab 96k -content_type audio/mpeg -f mp3 icecast://source:CHANGE_ME_SOURCE_PASSWORD@192.168.68.118:8000/radio2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
